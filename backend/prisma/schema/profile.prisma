model Profile {
  id          String   @id @default(uuid())
  name        String   @default("")
  headline    String   @default("")
  bio         String   @default("") @db.Text
  aboutMe     String   @default("") @db.Text
  resumeUrl   String?
  avatarUrl   String?

  email       String   @default("")
  phone       String?
  location    String?

  github      String?
  linkedin    String?
  facebook    String?
  codeforces  String?
  leetcode    String?

  updatedAt   DateTime @updatedAt

  @@map("profile")
}
