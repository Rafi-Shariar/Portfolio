<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <style>
    body { font-family: Arial, sans-serif; background-color: #f4f4f5; margin: 0; padding: 20px; color: #18181b; }
    .container { max-width: 560px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; padding: 24px; border: 1px solid #e4e4e7; }
    h2 { margin-top: 0; color: #09090b; font-size: 20px; }
    .field { margin-bottom: 12px; }
    .label { font-weight: bold; color: #71717a; font-size: 13px; text-transform: uppercase; }
    .value { margin-top: 4px; font-size: 15px; }
    .message-box { margin-top: 16px; padding: 14px; background-color: #fafafa; border-left: 4px solid #18181b; border-radius: 4px; white-space: pre-wrap; font-size: 15px; line-height: 1.5; }
  </style>
</head>
<body>
  <div class="container">
    <h2>New Message from Portfolio</h2>
    <div class="field">
      <div class="label">Sender Name</div>
      <div class="value"><%= name %></div>
    </div>
    <div class="field">
      <div class="label">Sender Email</div>
      <div class="value"><%= email %></div>
    </div>
    <% if (phone) { %>
    <div class="field">
      <div class="label">Sender Phone</div>
      <div class="value"><%= phone %></div>
    </div>
    <% } %>
    <div class="field">
      <div class="label">Message</div>
      <div class="message-box"><%= message %></div>
    </div>
  </div>
</body>
</html>